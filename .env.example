# Copia este archivo a .env y cambia los valores. .env nunca se versiona.
APP_ENV=development
LOG_LEVEL=info

# PostgreSQL (superusuario solo para inicializar la base)
POSTGRES_DB=last_mile
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_me_admin

# Un usuario por servicio, con permisos solo sobre su esquema
AUTH_DB_PASSWORD=change_me_auth
ORDER_DB_PASSWORD=change_me_orders
ZONE_DB_PASSWORD=change_me_zones
ROUTING_DB_PASSWORD=change_me_routing
DRIVER_DB_PASSWORD=change_me_drivers
TRACKING_DB_PASSWORD=change_me_tracking

REDIS_PASSWORD=change_me_redis

# Mínimo 32 caracteres. Genera uno con: openssl rand -hex 32
JWT_SECRET=change_me_change_me_change_me_change_me
JWT_TTL=1h

# Primer administrador, creado solo si la tabla de usuarios está vacía
BOOTSTRAP_ADMIN_EMAIL=admin@lastmile.local.dev
BOOTSTRAP_ADMIN_PASSWORD=change_me_admin_password

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
GATEWAY_PORT=8080

MAX_ORDERS_PER_ROUTE=4

# Documentación interactiva de la API en /docs (false para ocultarla)
ENABLE_API_DOCS=true
